# axlib credential configuration example.
# Relative credential/key paths are resolved from this TOML file's directory.

[credentials]
shared_service = "network-shared"

# Axlib-native AES-256-GCM text credential store.
[credential_file]
enabled = true
file = "/var/lib/axlib/credentials.axc"
key_file = "/etc/axlib/credential-file.key"
lock_timeout = 5.0
file_mode = "0660"
key_file_mode = "0640"
group = "netops"
enforce_permissions = true
# owner = "root"

# AES-256-GCM SQLite store. When both stores are enabled, SQLite is checked first.
[sqlite]
enabled = true
database = "/var/lib/axlib/credentials.db"
key_file = "/etc/axlib/sqlite-aes256.key"
timeout = 5.0
database_mode = "0660"
key_file_mode = "0640"
group = "netops"
enforce_permissions = true
# owner = "root"

# Optional plaintext cache. TLS is recommended for remote Redis endpoints.
# The password is never read from this file: set AXLIB_REDIS_PASSWORD.
[redis]
enabled = false
host = "localhost"
port = 6379
db = 15
# username = "axlib"                       # Redis ACL user
tls = false
# TLS file paths are not resolved from this file's directory: use absolute paths.
# ca_certs = "/etc/axlib/redis-ca.pem"     # CA bundle that verifies the server
# certfile = "/etc/axlib/redis-client.pem" # client certificate (mutual TLS)
# keyfile = "/etc/axlib/redis-client.key"  # its private key
# cert_reqs = "required"                   # required (default), optional, or none
connect_timeout = 2.0
socket_timeout = 2.0
cache_ttl = 900                            # seconds; 0 keeps entries until changed
key_prefix = "axlib"                       # default "": hashes named <prefix>:<service>

# axlib parse: TextFSM parsing of show-command output (uv add 'axlib[textfsm]').
# Template directories are searched before ntc-templates; relative paths are
# resolved from this file's directory.  Without template_dirs, a "textfsm"
# directory beside this file is used when it exists.
[textfsm]
platform = "cisco_ios"
template_dirs = ["textfsm"]
